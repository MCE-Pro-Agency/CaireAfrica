# Routage SPA (Apache / LiteSpeed)
# Corrige l'erreur 403 sur l'accès direct à /prestations et /menu :
# toute URL qui n'est pas un fichier réel est servie par index.html.
Options -Indexes
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . /index.html [L]
</IfModule>

# Cache long sur les fichiers versionnés par Vite
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|jpg|jpeg|png|webp|avif|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
